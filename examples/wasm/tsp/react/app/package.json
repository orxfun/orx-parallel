{
    "name": "orx-parallel-wasm-tsp-react-app",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build:wasm": "ORX_PARALLEL_WASM_BINDINGS=../wasm_bindings ORX_PARALLEL_WASM_OUT_DIR=./pkg node ../../../../../wasm-web/src/build.js build",
        "dev:full": "npm exec -- vite",
        "dev": "npm exec -- vite",
        "typecheck": "tsc --noEmit",
        "build": "npm run typecheck && npm exec -- vite build",
        "preview": "npm run build && npm exec -- vite preview",
        "serve:dist": "node scripts/serve-dist.mjs"
    },
    "dependencies": {
        "highlight.js": "^11.11.1",
        "orx-parallel-web": "file:../../../../../wasm-web",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    },
    "devDependencies": {
        "@types/react": "^19.1.10",
        "@types/react-dom": "^19.1.7",
        "@vitejs/plugin-react": "^5.0.0",
        "typescript": "^5.6.3",
        "vite": "^5.4.10"
    }
}